{
  "manifest_version": 3,
  "name": "Tin",
  "version": "0.1.0",
  "description": "Tells Tin which page each window shows and what's selected in it, so captures know what you were looking at.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "selection.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
