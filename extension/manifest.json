{
  "manifest_version": 3,
  "name": "Tin",
  "version": "0.2.0",
  "description": "Tells Tin which page each window shows, what's selected in it, the tweets X loads, and the images and videos where you pick, so captures know what you were looking at and keep it.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "selection.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "x-tweets.js",
        "x-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "x-relay.js"
      ],
      "run_at": "document_start"
    }
  ]
}
